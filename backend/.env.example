# Vortex — copie para .env e ajuste. Todos os valores têm default em app/config.py.
# O .env NUNCA vai para o Git: ele guarda a senha do banco.

# --- Persistência ---
# Com esta linha, a API usa PostgreSQL (Neon). Sem ela, roda em memória.
# DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

AMBIENTE=desenvolvimento

# --- IA (Gemini) ---
# Sem esta linha, a conversa usa só as regras determinísticas.
# GEMINI_API_KEY=sua_chave_do_google_ai_studio
# GEMINI_MODELO=gemini-3.5-flash-lite

# --- Demonstração ---
# Conversas simuladas carregadas na subida e no "Reiniciar demo". Padrão: true.
# SEMEAR_DEMONSTRACAO=true

# --- Privacidade ---
# Chave da referência pública do cliente (o CPF nunca sai pela API). Troque em produção.
# CHAVE_REFERENCIA=um_segredo_longo
# Dica dos 3 dígitos do CPF no simulador (recurso de demo).
# SIMULADOR_DICA_VERIFICACAO=true

# --- Administração ---
# Com esta linha, POST /reset (e o botão "Reiniciar demo") exige o token.
# Em produção (AMBIENTE diferente de desenvolvimento), sem token o reset fica desligado.
# ADMIN_TOKEN=um_segredo_longo

# --- Sessão ---
SESSAO_TTL_SEGUNDOS=1800

# --- Motor de fricção ---
LIMIAR_HANDOFF=70
LIMIAR_ATENCAO=40
LIMIAR_SIMILARIDADE=0.75

PESO_REPETICAO=18
PESO_INTENCAO_REPETIDA=12
PESO_PEDIDO_HUMANO=25
PESO_TROCA_CANAL=16
PESO_SENTIMENTO_BASE=6
PESO_SENTIMENTO_MAX=20
PESO_CAIXA_ALTA=5
PESO_LOOP=8
PESO_LOOP_MAX=24
PESO_IMPACIENCIA=8
PESO_DECAIMENTO=12

TURNOS_PARA_LOOP=4
TURNOS_MESMA_INTENCAO=3

# --- NLP ---
CONFIANCA_MINIMA_NLP=35
